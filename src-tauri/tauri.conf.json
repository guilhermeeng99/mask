{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mask",
  "version": "0.1.0",
  "identifier": "dev.guilherme.mask",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mask",
        "width": 960,
        "height": 640,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/guilhermeeng99/mask/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4QjJERDBGREY1OTlGQzEKUldUQm4xbmZEOTJ5bUdtK0ZJelAzSlNESnNTMzVXandZaklkYUk1TGpZeElTd3RuU1ZDYkU1MVMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
